{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Route between two US locations with the cheapest fuel stops (500 mi range, 10 MPG).\n\nSet `base_url` to your server (default http://127.0.0.1:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Plan a trip",
      "item": [
        {
          "name": "Chicago, IL → Denver, CO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has route and fuel stops', () => { pm.expect(body.route.distance_miles).to.be.above(0); pm.expect(body.fuel_stops).to.be.an('array'); });",
                  "pm.test('stop costs add up to total', () => pm.expect(body.fuel_stops.reduce((s, x) => s + x.cost, 0)).to.be.closeTo(body.fuel.total_cost, 0.01));",
                  "pm.test('at most 1 external API call', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "City, ST input is resolved offline, so the only external call is the route.",
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=Chicago, IL&finish=Denver, CO",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Denver, CO"
                }
              ]
            }
          }
        },
        {
          "name": "Chicago → Denver again (cached)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has route and fuel stops', () => { pm.expect(body.route.distance_miles).to.be.above(0); pm.expect(body.fuel_stops).to.be.an('array'); });",
                  "pm.test('stop costs add up to total', () => pm.expect(body.fuel_stops.reduce((s, x) => s + x.cost, 0)).to.be.closeTo(body.fuel.total_cost, 0.01));",
                  "pm.test('at most 1 external API call', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
                  "pm.test('served from cache with no API calls', () => { pm.expect(body.meta.cached).to.be.true; pm.expect(body.meta.external_api_calls).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Run after the previous request: identical trips are served from cache.",
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=Chicago, IL&finish=Denver, CO",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route",
                ""
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Chicago, IL"
                },
                {
                  "key": "finish",
                  "value": "Denver, CO"
                }
              ]
            }
          }
        },
        {
          "name": "New York → Los Angeles (coast to coast)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has route and fuel stops', () => { pm.expect(body.route.distance_miles).to.be.above(0); pm.expect(body.fuel_stops).to.be.an('array'); });",
                  "pm.test('stop costs add up to total', () => pm.expect(body.fuel_stops.reduce((s, x) => s + x.cost, 0)).to.be.closeTo(body.fuel.total_cost, 0.01));",
                  "pm.test('at most 1 external API call', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
                  "pm.test('needs several fuel stops', () => pm.expect(body.fuel_stops.length).to.be.at.least(6));",
                  "pm.test('no leg longer than the 500 mi range', () => { let prev = 0; for (const s of body.fuel_stops) { pm.expect(s.mile_marker - prev).to.be.at.most(500); prev = s.mile_marker; } pm.expect(body.route.distance_miles - prev).to.be.at.most(500); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Full state names are accepted too.",
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=New York, NY&finish=Los Angeles, California",
